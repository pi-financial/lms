{
    "name": "nextjs-boilerplate",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24.0.0",
        "yarn": ">=1.0.0",
        "npm": "please-use-yarn"
    },
    "scripts": {
        "dev": "next dev | pino-pretty",
        "build": "next build",
        "start": "next start",
        "lint": "oxlint && prettier --check .",
        "lint:fix": "oxlint --fix && prettier --write .",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
        "test": "jest --config tests/jest.config.mjs",
        "test:coverage": "jest --config tests/jest.config.mjs --coverage",
        "gen:tokens": "node scripts/generate-palette-css.mjs",
        "postinstall": "node scripts/copy-fonts.mjs"
    },
    "dependencies": {
        "@auth/core": "^0.41.2",
