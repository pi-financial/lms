# Copy to .env.local for development:  cp .env.example .env.local
#
# Every variable here is read by the code. Grouped by what breaks without it:
#   required   — the app will not start, or sign-in cannot complete
#   optional   — a feature degrades, the app keeps running
#   wired up   — the library exists and nothing reads it yet

# ─── Auth — Microsoft Entra ID ──────────────────────────── required ─────────
# OIDC straight to Entra: the password and the MFA policy stay with Microsoft, and the App roles
# assigned there arrive in the ID token as a flat `roles` claim (`lms-learner`, `lms-editor`).
#
# Missing any of these in production fails at boot — see libs/auth/env.ts. In development the app
# still runs and offers a dev-only sign-in instead, so the screens can be built before infra
# delivers the app registration (INFRA-REQUEST.md).

# `openssl rand -base64 32`. Salts the session cookie; rotating it signs everyone out.
AUTH_SECRET=

# The Entra app registration for this app — ask infra to create one.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Must name the tenant. Left on `common` the provider admits any Microsoft account, a personal
# outlook.com one included — so `env.ts` rejects anything but a tenant GUID.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/bfddd0fc-7ea7-4d70-adab-75e7bc3bb64a/v2.0

# This app's own public origin. Auth.js builds the OAuth redirect from it, and the cookie `Secure`
# flag follows whether it is https — an https deployment left on http serves cookies no browser
# stores.
AUTH_URL=http://localhost:3000

# ─── Observability (SigNoz) ─────────────────────────────── optional ─────────
# All off by default: nothing is sent until the flags below are on.
NEXT_PUBLIC_SIGNOZ_SERVICE_NAME=Pi.Lms.UI
NEXT_PUBLIC_SIGNOZ_LOG_ENABLED=false
NEXT_PUBLIC_SIGNOZ_TRACE_ENABLED=false
NEXT_PUBLIC_SIGNOZ_AUTO_INSTRUMENT=false

# Capitalised — SigNoz filters on this string verbatim: Development | Staging | Production
NEXT_PUBLIC_DEPLOYMENT_ENV=Development

# Server-only: the browser posts to /api/telemetry/* instead of reaching these directly.
SIGNOZ_OTLP_ENDPOINT=http://localhost:4318/v1/traces
SIGNOZ_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# ─── lms-srv ────────────────────────────────────────────── optional ─────────
# The service that owns courses, progress and certificates. It does not exist yet.
#
# Unset is the current state and a working one: every read serves the sample content in
# libs/api/fixtures.ts and each screen says so on the page. Every *write* still throws — a write
# that silently succeeds against nothing tells a learner their progress was saved when nothing
# recorded it. Setting this switches the reads to the service and removes the banner.
LMS_SRV_BASE_URL=

# ─── Pi services (client-libs) ──────────────────────────── optional ─────────
# Resolves only inside the Pi network — the /users demo page needs the VPN. Without it that one
# page renders an explicit error; nothing else is affected.
USER_V2_HOST=http://user-api-v2.nonprod.pi.internal

# ─── Redis ──────────────────────────────────────────────── optional ─────────
# Unset means no cache and every call falls through to its own source — a cache whose absence takes
# the app down is worse than no cache. Intended for the watch heartbeat and for holding a quiz
# attempt's shuffled question order across a reload.
REDIS_URL=

# ─── GrowthBook ─────────────────────────────────────────── wired up ─────────
# libs/growthbook/ and the provider in app/(app)/layout.tsx are in place; no screen reads a flag
# yet. Unset means every flag falls back to its default, which is a valid configuration.
#
# Server-side only on purpose: flags are evaluated on the server and only the results reach the
# browser, so targeting rules never leave the cluster.
GROWTHBOOK_HOST=https://cdn.growthbook.io
# SDK client key from GrowthBook → SDK Connections. Format: sdk-xxxxxxxxxxxx
GROWTHBOOK_KEY=

# ─── Directus CMS ───────────────────────────────────────── wired up ─────────
# libs/directus/ is in place; nothing reads it yet — the copy on every screen is in the source.
#
# Base URL only — the SDK appends /items itself, so a value ending in /items yields
# .../items/items/web_contents and 403s.
DIRECTUS_HOST=https://api.prod.pi.financial/cms
DIRECTUS_TOKEN=
