# Build-time only. `next build` inlines every NEXT_PUBLIC_* into the client bundle as a literal.
# __NAME__ is a placeholder that docker/entrypoint.mjs replaces from the container env at startup;
# anything else is frozen at build time.
NEXT_PUBLIC_SIGNOZ_SERVICE_NAME=Pi.NextjsBoilerplate.UI
NEXT_PUBLIC_SIGNOZ_LOG_ENABLED=true
NEXT_PUBLIC_SIGNOZ_TRACE_ENABLED=true
NEXT_PUBLIC_SIGNOZ_AUTO_INSTRUMENT=true
# Development | Staging | Production — SigNoz filters on this string verbatim.
NEXT_PUBLIC_DEPLOYMENT_ENV=__NEXT_PUBLIC_DEPLOYMENT_ENV__
